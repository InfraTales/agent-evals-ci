{
  "name": "agent-evals-ci",
  "version": "1.0.0",
  "description": "An evaluation harness that tests an AI agent in CI, plus the same checks as an Amazon Bedrock AgentCore code-based evaluator for live traffic. AWS CDK, TypeScript.",
  "private": true,
  "license": "MIT-0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "synth": "cdk synth --quiet",
    "evals": "ts-node src/cli/run-evals.ts",
    "check": "npm run build && npm run lint && npm test && npm run evals && npm run synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "mutate": "ts-node scripts/mutation-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "aws-cdk-lib": "^2.273.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1145.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
